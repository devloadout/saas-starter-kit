# Copy to .env.local and fill in. The app RUNS WITHOUT any of these (demo mode);
# set them for production.

# Session signing secret (any long random string). REQUIRED in production.
AUTH_SECRET=change-me-to-a-long-random-string

# Stripe (optional — only needed to enable real checkout)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# Public URL of your app (used for Stripe redirect URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
